# Application Runtime
NODE_ENV=development
PORT=5000
CLIENT_BASE_URL=http://localhost:5173

# Database Persistence (PostgreSQL / Replit Postgres)
DATABASE_URL=postgresql://user:password@localhost:5432/food_delivery_db?sslmode=disable

# Authentication Secrets
JWT_SECRET=super-secure-production-jwt-token-key-change-this
SESSION_EXPIRY=7d

# Google Gemini AI SDK
GEMINI_API_KEY=AIzaSyYourProductionGeminiApiKeyHere
GROQ_API_KEY=gsk_YourOptionalGroqApiKeyHere

# Hyperlocal Delivery Settings
DEFAULT_SEARCH_RADIUS_KM=15.0
BASE_DELIVERY_FEE_CENTS=299
PER_KM_DELIVERY_FEE_CENTS=100
DEFAULT_TAX_RATE_PERCENTAGE=8.25
